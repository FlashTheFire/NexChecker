[Unit]
Description=NexChecker Universal FastAPI Backend Service
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{SERVICE_USER}}
WorkingDirectory={{APP_DIR}}
ExecStart={{UVICORN_BIN}} api.main:app --host 0.0.0.0 --port {{API_PORT}} --workers 2
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
EnvironmentFile={{APP_DIR}}/.env

# Security Sandbox
ProtectSystem=full
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

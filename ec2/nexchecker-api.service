[Unit]
Description=NexChecker Universal FastAPI Backend Service
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/NexChecker
ExecStart=/home/ubuntu/NexChecker/venv/bin/uvicorn api.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
EnvironmentFile=/home/ubuntu/NexChecker/.env

ProtectSystem=full
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

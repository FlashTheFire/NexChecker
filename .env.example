# =============================================================================
# NexChecker — Environment Configuration
# Copy this file to .env and fill in required values.
# NEVER commit .env to git. All secrets must live here only.
# =============================================================================

# --- Application & Host ---
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- Local Domain & Networking ---
LOCAL_DOMAIN=nexchecker.127.0.0.1.nip.io

# --- Web Application & Public Tunnel ---
# Cloudflare Tunnel provides instant, zero-warning universal HTTPS on Mobile, PC, Telegram Webview
WEBAPP_URL=https://nexchecker.127.0.0.1.nip.io
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TUNNEL_CMD=tunnel --url https://nginx:443 --no-tls-verify
SECRET_KEY=nexchecker_change_this_to_64_random_chars_in_production_required

# --- Telegram Bot ---
# Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_ID=1889471360

# Webhook mode (leave empty for automatic polling mode in dev)
WEBHOOK_URL=
WEBHOOK_SECRET=

# --- NexNum Virtual Number Service ---
NEXNUM_BASE_URL=https://nexnum.in/stubs/handler_api.php

# Platform Service Codes on NexNum
MYNTRA_SERVICE_CODE=nl
FLIPKART_SERVICE_CODE=xt
BIGBASKET_SERVICE_CODE=bb
ZOMATO_SERVICE_CODE=dy

# --- Microservice Endpoints (Optional / Fallback) ---
ZOMATO_CHECKER_URL=http://127.0.0.1:3000/api/checker/phone

# --- CORS ---
CORS_ORIGINS=*
